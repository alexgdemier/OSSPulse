POSTGRES_DB=oss_pulse
POSTGRES_USER=oss_pulse
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+pg8000://oss_pulse:replace-with-a-long-random-password@db:5432/oss_pulse
DATABASE_SSL=false
GITHUB_TOKEN=
GITHUB_MAX_PAGES=3
GITHUB_TIMEOUT_SECONDS=15
WEB_PORT=3000
ANALYSIS_RATE_LIMIT_ENABLED=true
ANALYSIS_TRUST_FORWARDED_FOR=true
ANALYSIS_RATE_LIMIT_PER_MINUTE=2
ANALYSIS_RATE_LIMIT_PER_HOUR=10
ANALYSIS_RATE_LIMIT_GLOBAL_PER_HOUR=
ANALYSIS_CACHE_TTL_SECONDS=21600
REPORT_RETENTION_DAYS=90
REPORT_MAX_HISTORY_PER_REPOSITORY=10
ANALYSIS_PROXY_SECRET=
